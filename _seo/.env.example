# Copy to _seo/.env (gitignored) and fill in. Scripts read this file; nothing here is committed.

# --- Google (Search Console + GA4) -------------------------------------------
# Google Cloud console -> new project -> enable "Google Search Console API" and
# "Google Analytics Data API" -> OAuth client ID (type: Desktop app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled by: python3 scripts/google_auth.py   (one-time browser consent)
GOOGLE_REFRESH_TOKEN=
# Search Console property exactly as it appears in GSC ("sc-domain:efficio.tech" or "https://efficio.tech/")
GSC_SITE=sc-domain:efficio.tech
# GA4 property ID (numeric, Admin -> Property details). Not the G-XXXX measurement ID.
GA4_PROPERTY_ID=

# --- PageSpeed Insights (optional key; works unauthenticated at low volume) ---
PAGESPEED_API_KEY=

# --- DataForSEO ----------------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# "sandbox" returns fake data in the real shape and costs nothing. Switch to "live" only
# after the agent has run cleanly against sandbox.
DATAFORSEO_MODE=sandbox
# Hard cap on live API calls per script invocation (spend limit).
DATAFORSEO_MAX_CALLS=10

# --- Firecrawl -----------------------------------------------------------------
FIRECRAWL_API_KEY=

# --- Parallel (web search) -------------------------------------------------------
PARALLEL_API_KEY=
